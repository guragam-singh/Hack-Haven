  m_Script: {fileID: 11500000, guid: 149bc7d5efce05141be27fa4cf4e1e5d, type: 3}
  m_Name: Level01Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::Reverbat.DialogueLibrary
  entries:
  - triggerId: level01.begin
    characterName: BAT DRACULA
    text: Great. He gets the castle, the throne, and the entire kingdom... and I get wings the size of teaspoons.
    voiceClip: {fileID: 8300000, guid: b4b1995c1db02ce4794d3c9c257642c2, type: 3}
    duration: 8.5
  - triggerId: level01.first-pulse
    characterName: BAT DRACULA
    text: Wonderful. I've lost my body AND my eyesight. What's next, taxes?
    voiceClip: {fileID: 8300000, guid: 54d72d5d010bb8245b7e557d77bb6b82, type: 3}
    duration: 5.5
  - triggerId: level01.reflector-tilted
    characterName: BAT DRACULA
    text: Behold! The terrifying power of... sitting on things.
    voiceClip: {fileID: 8300000, guid: 0c2b1d50b445870468db4a62a8724525, type: 3}
    duration: 6
  - triggerId: level01.artifact-collected
    characterName: BAT DRACULA
    text: Finally, some of my power back. Now, where's that oversized impostor?
    voiceClip: {fileID: 8300000, guid: 28390dec97e26764ba11761809e56d8b, type: 3}
    duration: 6.5
